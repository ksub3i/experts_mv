# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Everything is optional locally:
# without Supabase, submissions are logged to the console instead of saved.

# --- Supabase (database + file storage) ---------------------------------------
# Supabase dashboard → Project Settings → API. (Added automatically if you
# connect Supabase through the Vercel Marketplace.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email alerts for new estimate requests (Resend) ---------------------------
RESEND_API_KEY=
# Comma-separated list of team addresses to notify
LEAD_NOTIFICATION_EMAIL=
# Sender for the alert emails: "Name <address@domain>" or "address@domain".
# Required for emails to send — if missing or invalid, the request is still
# saved but no email is sent and a clear error is logged on the server.
# Until your own domain is verified in Resend, you can use Resend's shared test
# sender "onboarding@resend.dev" (it only delivers to your Resend account's own
# email). Switch to an address on your verified domain once it's decided.
EMAIL_FROM=Your Company <quotes@example.com>

# --- Cal.com consultation booking ----------------------------------------------
# Your event link without the domain, e.g. "theexperts/consultation".
# Empty = the booking step shows your phone number instead.
NEXT_PUBLIC_CALCOM_LINK=
# Secret set on the Cal.com webhook pointing to /api/webhooks/calcom
CALCOM_WEBHOOK_SECRET=

# --- Site ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
