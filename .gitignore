# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand source files & local tooling — kept out of the public repo
# (the logos the site uses live in public/brand)
/Brand Guidelines.pdf
/Logos/
/.claude/
# full General Sans family (the weights the site uses are in src/fonts)
/font/

# Supabase CLI local state (created by `supabase link`)
/supabase/.temp/
/supabase/.branches/
